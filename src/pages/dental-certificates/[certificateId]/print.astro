---
import HistoryExportLayout from "@/layouts/HistoryExportLayout.astro";
import DentalCertificateDocument from "@/components/DentalCertificateDocument.astro";
import { canReadClinicalData } from "@/lib/authz";
import { loadCertificatePrint } from "@/lib/dental-certificate-print";
import { formatManilaDateLong, toManilaDateKey } from "@/lib/manila-date";
import { workspaceQuery } from "@/lib/workspace-url";

const role = Astro.locals.userRole;
if (!canReadClinicalData(role)) {
  return Astro.redirect("/patients");
}

const certificateId = Astro.params.certificateId;
if (!certificateId) {
  return Astro.redirect("/patients");
}

const data = await loadCertificatePrint(certificateId);
if (!data) {
  return Astro.redirect("/patients");
}

const { certificate, patient } = data;
const issuedYmd = toManilaDateKey(new Date(certificate.issuedAt));
const issuedAtLabel = formatManilaDateLong(issuedYmd);
const resumeDateLabel = certificate.resumeDate
  ? formatManilaDateLong(certificate.resumeDate)
  : null;

const backHref = `/workspace/certificate${workspaceQuery(patient.id, certificate.visitId)}`;
const title = `Dental certificate #${certificate.certificateNumber} · ${patient.lastName}, ${patient.firstName}`;
---

<HistoryExportLayout title={title}>
  <div class="certificate-print-toolbar print-hide">
    <button
      type="button"
      class="certificate-print-toolbar__btn"
      onclick="window.print()"
    >
      Print
    </button>
    <a href={backHref} class="certificate-print-toolbar__link">
      Back to certificates
    </a>
  </div>

  <DentalCertificateDocument
    patient={patient}
    certificateNumber={certificate.certificateNumber}
    issuedAtLabel={issuedAtLabel}
    purpose={certificate.purpose}
    purposeDetail={certificate.purposeDetail}
    resumeMode={certificate.resumeMode}
    resumeDateLabel={resumeDateLabel}
    resumeDays={certificate.resumeDays}
    remarks={certificate.remarks}
    lines={certificate.lines.map((line) => ({
      name: line.name,
      detail: line.detail,
      performedOnLabel: line.performedOn
        ? formatManilaDateLong(line.performedOn)
        : null,
    }))}
  />
</HistoryExportLayout>

<style>
  .certificate-print-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0.75rem;
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
  }

  .certificate-print-toolbar__btn {
    border: none;
    border-radius: 0.375rem;
    background: #efaac4;
    color: #1e293b;
    font-size: 0.875rem;
    font-weight: 600;
    padding: 0.5rem 1rem;
    cursor: pointer;
  }

  .certificate-print-toolbar__link {
    display: inline-flex;
    align-items: center;
    border: 1px solid #e2e8f0;
    border-radius: 0.375rem;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: #1e293b;
    text-decoration: none;
  }
</style>
