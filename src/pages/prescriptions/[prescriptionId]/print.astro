---
import HistoryExportLayout from "@/layouts/HistoryExportLayout.astro";
import PrescriptionDocument from "@/components/PrescriptionDocument.astro";
import { canReadClinicalData } from "@/lib/authz";
import { formatManilaDateLong, toManilaDateKey } from "@/lib/manila-date";
import { loadPrescriptionPrint } from "@/lib/prescription-print";

const role = Astro.locals.userRole;
if (!canReadClinicalData(role)) {
  return Astro.redirect("/patients");
}

const prescriptionId = Astro.params.prescriptionId;
if (!prescriptionId) {
  return Astro.redirect("/prescriptions");
}

const data = await loadPrescriptionPrint(prescriptionId);
if (!data) {
  return Astro.redirect("/prescriptions");
}

const prescribedYmd = toManilaDateKey(new Date(data.prescription.prescribedAt));
const prescribedAtLabel = formatManilaDateLong(prescribedYmd);
const backHref = `/prescriptions?patientId=${encodeURIComponent(data.patient.id)}`;
const title = `Prescription #${data.prescription.prescriptionNumber} · ${data.patient.lastName}, ${data.patient.firstName}`;
---

<HistoryExportLayout title={title}>
  <div class="prescription-print-toolbar print-hide">
    <button type="button" class="prescription-print-toolbar__btn" onclick="window.print()">
      Print
    </button>
    <a href={backHref} class="prescription-print-toolbar__link">
      Back to prescriptions
    </a>
  </div>

  <PrescriptionDocument
    patient={data.patient}
    prescriptionNumber={data.prescription.prescriptionNumber}
    prescribedAtLabel={prescribedAtLabel}
    notes={data.prescription.notes}
    lines={data.prescription.lines.map((line) => ({
      name: line.name,
      doseStrength: line.doseStrength,
      instructions: line.instructions,
      quantity: line.quantity,
      quantityUnit: line.quantityUnit,
    }))}
  />
</HistoryExportLayout>

<style>
  .prescription-print-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0.75rem;
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
  }

  .prescription-print-toolbar__btn {
    border: none;
    border-radius: 0.375rem;
    background: #efaac4;
    color: #1e293b;
    font-size: 0.875rem;
    font-weight: 600;
    padding: 0.5rem 1rem;
    cursor: pointer;
  }

  .prescription-print-toolbar__link {
    display: inline-flex;
    align-items: center;
    border: 1px solid #e2e8f0;
    border-radius: 0.375rem;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: #1e293b;
    text-decoration: none;
  }
</style>
