---
import AppShell from "@/layouts/AppShell.astro";
import { AdminHub } from "@/components/AdminHub";

const isAdminLike =
  Astro.locals.userRole === "ADMIN_I" ||
  Astro.locals.userRole === "ADMIN_II";
---

<AppShell title="Administration">
  {
    isAdminLike ? (
      <AdminHub client:load initialRole={Astro.locals.userRole} />
    ) : (
      <p class="text-destructive">
        You do not have access to this page.{" "}
        <a href="/patients" class="underline underline-offset-4">
          Return to patients
        </a>
        .
      </p>
    )
  }
</AppShell>
