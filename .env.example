# --- Local SQLite (default when DATABASE_URL is unset) ---
# Absolute or relative path to the SQLite file (server-only)
DATABASE_PATH=./data/app.db

# --- Supabase / Postgres (optional) ---
# When set to a postgres:// or postgresql:// URL, the app uses Supabase Postgres instead of SQLite.
# In the Supabase dashboard: Project Settings → Database → Connection string → URI (transaction pooler, port 6543).
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# DATABASE_PROVIDER=postgres

# --- Docker Compose (Postgres + SSR + nginx on 443) ---
# Copy to .env on the server; do not commit .env. Host dev can keep SQLite above without these.
# POSTGRES_USER=clinical
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=clinical_hub
# DATABASE_PROVIDER=postgres
# DATABASE_URL=postgresql://clinical:change-me@postgres:5432/clinical_hub
# HEALTH_CHECK_SECRET=generate-a-long-random-string
# NGINX_CONFIG_DIR=./nginx
# NGINX_CERT_DIR=./nginx/certs
# NODE_VERSION=24-alpine
# APP_HOST=your-clinic-domain.com

# Optional: public hostname encoded in the patient registration QR (no https://)
# Copy this file to .env first — Astro does not read .env.example.
# Uncomment APP_HOST in your .env, set your clinic domain, then restart `bun run dev`.
# When unset, the QR uses the host from the current browser request.
# APP_HOST=clinic.example.com

# Optional: used only by `bun run db:seed` to create an ADMIN user and sample catalog rows
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me

# Optional: bearer token for unauthenticated GET /api/health (load balancers / probes)
# HEALTH_CHECK_SECRET=your-long-random-secret

# Optional: signs the short-lived cookie after Admin I enters the administration passcode
# ADMIN_GATE_SECRET=your-long-random-secret

# Password-reset notifications (forgot password emails the clinic admin)
# CLINIC_ADMIN_EMAIL=xjaequeral@gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-app-password
# SMTP_FROM=noreply@yourclinic.com
