{
  "name": "clinical-hub",
  "type": "module",
  "version": "0.0.1",
  "description": "Sta.Isabel Dental Clinic — Astro SSR, React, shadcn/ui, Drizzle, SQLite or Supabase Postgres. Use `bun run db:migrate` (runs via tsx/Node) because better-sqlite3 is not supported by the Bun runtime on Windows.",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "node ./dist/server/entry.mjs",
    "db:generate": "drizzle-kit generate",
    "db:generate:pg": "drizzle-kit generate --config drizzle.config.pg.ts",
    "db:migrate": "tsx ./src/db/migrate.ts",
    "db:migrate:pg": "tsx ./src/db/migrate.pg.ts",
    "db:fix-schema": "tsx ./src/db/apply-pending-schema.ts",
    "db:seed": "tsx ./src/db/seed.ts",
    "db:push": "drizzle-kit push",
    "db:push:pg": "drizzle-kit push --config drizzle.config.pg.ts",
    "db:studio": "drizzle-kit studio",
    "db:studio:pg": "drizzle-kit studio --config drizzle.config.pg.ts"
  },
  "dependencies": {
    "@astrojs/netlify": "^7.0.9",
    "@astrojs/node": "^10.1.1",
    "@astrojs/react": "5.0.5",
    "@astrojs/tailwind": "^6.0.2",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.13",
    "astro": "^6.3.3",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.41.0",
    "html2pdf.js": "^0.10.2",
    "lucide-react": "^0.503.0",
    "nodemailer": "^6.10.1",
    "postgres": "^3.4.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.75.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/nodemailer": "^6.4.23",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.30.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
